# Postgres de Supabase: pooler de transacciones (6543) para la app y de sesion (5432) para migraciones.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=dev"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=dev"
JWT_ACCESS_SECRET="obra-os-dev-access-secret-change-me"
JWT_REFRESH_SECRET="obra-os-dev-refresh-secret-change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Correos (Resend). Vacio en local: se imprimen en consola.
RESEND_API_KEY=""
CORREO_REMITENTE="Bitácora <no-responder@tu-dominio.mx>"
# Base de los links de los correos; en Vercel se toma VERCEL_BRANCH_URL si falta.
APP_URL="http://localhost:5173"
