{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server && npm ci --prefix web",
  "buildCommand": "cd server && npx prisma generate && npx prisma migrate deploy && cd ../web && npm run build",
  "outputDirectory": "web/dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "server/node_modules/pdfkit/js/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
